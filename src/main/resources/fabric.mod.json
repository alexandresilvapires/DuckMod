{
	"schemaVersion": 1,
	"id": "duckmod",
	"version": "${version}",
	"name": "Duck Mod",
	"description": "Adds ducks to Minecraft, exactly what you needed!",
	"authors": [
		"Alexandre Pires"
	],
	"contact": {
		"homepage": "https://alexandresilvapires.github.io/",
		"sources": "https://github.com/alexandresilvapires/DuckMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/duckmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"alexduckmod.duckmod.Duckmod"
		],
		"client": [
			"alexduckmod.duckmod.DuckmodClient"
		]
	},
	"mixins": [
		"duckmod.mixins.json",
		{
			"config": "duckmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": ">=26.1",
		"java": ">=25"
	},
	"suggests": {
		"another-mod": "*"
	}
}